{
  "expo": {
    "name": "TornadoNation (Snack Demo)",
    "slug": "tornadonation-snack-demo",
    "version": "1.0.0",
    "icon": "./assets/images/icon.png",
    "assetBundlePatterns": [
      "assets/**/*"
    ],
    "orientation": "portrait",
    "scheme": "tornadonation-snack",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hligon.tornadonationsnackdemo",
      "buildNumber": "2",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.hligon.tornadonationsnackdemo",
      "versionCode": 2,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b5d5460c-b67d-44a7-bd52-24b52ed3eacf"
      }
    }
  }
}
