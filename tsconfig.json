{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowArbitraryExtensions": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      "@tornado-nation/shared": [
        "./packages/shared/src/index.ts"
      ],
      "@tornado-nation/ui": [
        "./packages/ui/src/index.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
